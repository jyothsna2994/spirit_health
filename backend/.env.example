PORT=5000

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated models, tried in order (falls back to the next on quota / overload)
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash

# MongoDB Atlas connection string
MONGODB_URI=

# Long random string used to sign login tokens:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Demo / UI work without spending Gemini quota. Records are stored with mode "mock" and labelled "[Sample]".
# MOCK_AI=true
# Demo OTP for the mock ABHA link
# MOCK_ABHA_OTP=123456
