PORT=5000
NODE_ENV=development
DNS_SERVERS=system

# Google AI Studio key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated models, tried in order
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash

# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string_here

# Long random string used to sign login tokens
JWT_SECRET=your_long_random_jwt_secret_here

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8081

# Demo / UI work without spending Gemini quota
# MOCK_AI=true

# Demo OTP for the mock ABHA link
# MOCK_ABHA_OTP=123456